# ==============================================================================
# CampusConnect - Environment Configuration
# ==============================================================================

# College Configuration
NEXT_PUBLIC_COLLEGE_NAME="Apex Institute of Technology"
NEXT_PUBLIC_COLLEGE_CODE="AIT"
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=".edu,.ac.in"

# Supabase Configuration
# Note: CampusConnect features an automatic "Contributor Mock Mode". If these keys
# are omitted or left blank, the app runs locally with a full interactive mock dataset!
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (for admin seed scripts only)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
